{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HeadsUp",
  "version": "3.3.0",
  "identifier": "io.github.goktugzaaa.headsup",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "overlay.html",
        "title": "HeadsUp",
        "width": 1280,
        "height": 640,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "settings",
        "create": false,
        "url": "settings.html",
        "title": "HeadsUp Settings",
        "width": 560,
        "height": 720,
        "minWidth": 400,
        "minHeight": 360,
        "center": true,
        "preventOverflow": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#141416",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/icon.png"]
  }
}
